# .gitignore

.env
.env.*
!.env.example

.venv/
__pycache__/
*.py[cod]

.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

.idea/
.vscode/

data/

dist/
build/
*.egg-info/

# Результаты ручных/E2E-проверок являются клиентскими копиями
# пользовательских отчётов и не должны попадать в Git.
artifacts/

# Реальные документы используются локально для acceptance tests
# и никогда не должны попадать в Git.
tests/fixtures/private/*
!tests/fixtures/private/.gitkeep