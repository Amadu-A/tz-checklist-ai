# .env.example

COMPOSE_PROJECT_NAME=tz-checklist-ai

APP_NAME=TZ Checklist AI
APP_VERSION=0.1.0
APP_ENV=dev
DOCS_ENABLED=true

API_HOST=0.0.0.0
API_PORT=8000

API_BIND_IP=0.0.0.0
API_HOST_PORT=8110

# Максимальный размер входного PDF: 100 MiB.
MAX_UPLOAD_BYTES=104857600

# ----------------------------------------------------------------------
# Shared Ollama
# ----------------------------------------------------------------------

OLLAMA_BASE_URL=http://ollama:11434

OLLAMA_VLM_MODEL=qwen3-vl:8b-instruct
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:4b
OLLAMA_LLM_MODEL=qwen3-vl:8b-instruct

OLLAMA_KEEP_ALIVE=1m
OLLAMA_REQUEST_TIMEOUT_SECONDS=500

# ----------------------------------------------------------------------
# GPU
# ----------------------------------------------------------------------

GPU_TASK_CONCURRENCY=1
VLM_PAGES_IN_FLIGHT=1

# ----------------------------------------------------------------------
# Checklist classification
# ----------------------------------------------------------------------

CLASSIFICATION_MAX_PAGES=2
CLASSIFICATION_MIN_NATIVE_CHARS=120
CLASSIFICATION_MIN_CONFIDENCE=0.70
CLASSIFICATION_MIN_PAGE_CHARS=40
VLM_FALLBACK_MAX_PAGES=2

# ----------------------------------------------------------------------
# Retrieval
# ----------------------------------------------------------------------

RETRIEVAL_CHUNK_MAX_CHARS=1800
RETRIEVAL_CHUNK_OVERLAP_CHARS=300
RETRIEVAL_TOP_K=4
RETRIEVAL_EMBEDDING_BATCH_SIZE=16
RETRIEVAL_SEMANTIC_WEIGHT=0.65
RETRIEVAL_LEXICAL_WEIGHT=0.35

# ----------------------------------------------------------------------
# Answer extraction
# ----------------------------------------------------------------------

ANSWER_BATCH_SIZE=6
ANSWER_FOUND_MIN_CONFIDENCE=0.6

# Targeted VLM применяется только после native pipeline.
ANSWER_VLM_FALLBACK_MAX_PAGES=4

# Страница с меньшим количеством native text считается
# кандидатом для visual fallback.
ANSWER_VLM_WEAK_PAGE_MAX_CHARS=80

# ----------------------------------------------------------------------
# PDF
# ----------------------------------------------------------------------

PDF_RENDER_DPI=144
PDF_JPEG_QUALITY=85

# ----------------------------------------------------------------------
# RabbitMQ
# ----------------------------------------------------------------------

RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_VHOST=tz_checklist_ai
RABBITMQ_USER=tz_checklist_ai

RABBITMQ_PASSWORD=change_me_before_use

CELERY_QUEUE_NAME=tz-checklist-ai

# ----------------------------------------------------------------------
# Temporary user files
# ----------------------------------------------------------------------

DATA_DIR=/data

RESULT_FILE_TTL_MINUTES=60
ORPHAN_JOB_TTL_HOURS=6
FAILED_JOB_STATE_TTL_HOURS=24
CLEANUP_INTERVAL_SECONDS=600

CHECKLIST_RESOURCES_DIR=/app/resources/checklists
TEST_DATA_DIR=/test-data