# .env.example

COMPOSE_PROJECT_NAME=tz-checklist-ai

APP_NAME=TZ Checklist AI
APP_VERSION=0.1.0
APP_ENV=dev
DOCS_ENABLED=true

API_HOST=0.0.0.0
API_PORT=8000

API_BIND_IP=0.0.0.0
API_HOST_PORT=8110

# Shared Ollama.
OLLAMA_BASE_URL=http://ollama:11434

# Единственная AI-модель, необходимая на этапе 2.
# Может быть заменена другой multimodal-моделью через .env.
OLLAMA_VLM_MODEL=qwen3-vl:8b-instruct

# Модель, загруженная запросами этого проекта,
# может быть выгружена примерно через 1 минуту простоя.
OLLAMA_KEEP_ALIVE=1m
OLLAMA_REQUEST_TIMEOUT_SECONDS=300

# RTX 3090 / 24 GB.
GPU_TASK_CONCURRENCY=1
VLM_PAGES_IN_FLIGHT=1

# Для определения типа ТЗ смотрим только начало документа.
CLASSIFICATION_MAX_PAGES=2

# Если native text короче этого значения,
# считаем его недостаточным и разрешаем VLM fallback.
CLASSIFICATION_MIN_NATIVE_CHARS=120

# Минимальная уверенность native-text классификации,
# при которой VLM для определения чек-листа не вызывается.
CLASSIFICATION_MIN_CONFIDENCE=0.70

# Страница считается слабой по text layer,
# если на ней меньше этого числа символов.
CLASSIFICATION_MIN_PAGE_CHARS=40

# Даже при fallback не отправляем в VLM больше
# указанного числа страниц для выбора чек-листа.
VLM_FALLBACK_MAX_PAGES=2

PDF_RENDER_DPI=144
PDF_JPEG_QUALITY=85

CHECKLIST_RESOURCES_DIR=/app/resources/checklists

TEST_DATA_DIR=/test-data

# Подключим на этапе 3.
RABBITMQ_URL=

DATA_DIR=/data