# .env.example

COMPOSE_PROJECT_NAME=tz-checklist-ai

APP_NAME=TZ Checklist AI
APP_VERSION=0.1.0
APP_ENV=dev
DOCS_ENABLED=true

API_HOST=0.0.0.0
API_PORT=8000

API_BIND_IP=0.0.0.0
API_HOST_PORT=8110

# ----------------------------------------------------------------------
# Shared Ollama
# ----------------------------------------------------------------------

OLLAMA_BASE_URL=http://ollama:11434

# Основная multimodal/generative модель.
OLLAMA_VLM_MODEL=qwen3-vl:8b-instruct

# Используется только для semantic retrieval.
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:4b

OLLAMA_KEEP_ALIVE=1m
OLLAMA_REQUEST_TIMEOUT_SECONDS=300

# ----------------------------------------------------------------------
# GPU
# ----------------------------------------------------------------------

# RTX 3090 / 24 GB.
# Celery worker выполняет только одну AI-задачу одновременно.
GPU_TASK_CONCURRENCY=1
VLM_PAGES_IN_FLIGHT=1

# ----------------------------------------------------------------------
# Checklist detection
# ----------------------------------------------------------------------

CLASSIFICATION_MAX_PAGES=2
CLASSIFICATION_MIN_NATIVE_CHARS=120
CLASSIFICATION_MIN_CONFIDENCE=0.70
CLASSIFICATION_MIN_PAGE_CHARS=40
VLM_FALLBACK_MAX_PAGES=2

PDF_RENDER_DPI=144
PDF_JPEG_QUALITY=85

# ----------------------------------------------------------------------
# RabbitMQ
# ----------------------------------------------------------------------

RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_VHOST=tz_checklist_ai
RABBITMQ_USER=tz_checklist_ai

# В реальном .env обязательно заменить.
RABBITMQ_PASSWORD=change_me_before_use

CELERY_QUEUE_NAME=tz-checklist-ai

# ----------------------------------------------------------------------
# Temporary user files
# ----------------------------------------------------------------------

DATA_DIR=/data

# Результат, который пользователь не забрал.
RESULT_FILE_TTL_MINUTES=60

# Незавершённое/зависшее задание.
ORPHAN_JOB_TTL_HOURS=6

# Маленькие metadata FAILED job можно оставить немного дольше,
# чтобы status endpoint успел показать причину ошибки.
FAILED_JOB_STATE_TTL_HOURS=24

# Как часто Celery Beat запускает страховочную очистку.
CLEANUP_INTERVAL_SECONDS=600

CHECKLIST_RESOURCES_DIR=/app/resources/checklists

TEST_DATA_DIR=/test-data